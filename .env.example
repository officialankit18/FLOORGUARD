# FLOOR GUARD System Environment Variables
PORT=3001
NODE_ENV=development

# Frontend API & WebSocket URLs
VITE_API_BASE_URL=/api
VITE_WS_URL=ws://localhost:3001

# Hardware Device Ingestion Security Token (for ESP8266 HTTP POST signature)
DEVICE_AUTH_SECRET=floorguard-device-shared-secret-demo

# MongoDB Atlas cloud history (M0 free tier)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=floorguard

# Generate locally with: node scripts/setup-push.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://floorguard.onrender.com

# Floor verifier runs on the always-on laptop backend (same Wi-Fi as Cam 2).
# Render disables verification by default because it cannot reach a private camera.
FLOOR_VERIFIER_ENABLED=1
# Leave empty to use the laptop relay's Cam 2 at 127.0.0.1:3012.
FLOOR_CAMERA_IP=
FLOOR_CAMERA_CAPTURE_URL=http://127.0.0.1:3012/camera/laptop/capture
# Laptop backend forwards classified events and snapshots to the deployed app.
FLOOR_REMOTE_API_URL=https://floorguard.onrender.com

# Render Free-service keep-alive. Render supplies RENDER_EXTERNAL_URL automatically.
# Set KEEP_ALIVE_ENABLED=false to disable it. Keep the default interval below 15 minutes.
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MS=540000
