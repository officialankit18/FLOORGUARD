{
  "name": "floor-guard-iot-security",
  "version": "1.0.0",
  "description": "FLOOR GUARD — An IoT-Based Smart Anti-Theft Floor Mat System with Real-Time Computer Vision and Identity Verification",
  "type": "module",
  "scripts": {
    "relay": "node scripts/start-camera-relay.mjs",
    "dev": "vite",
    "server": "tsx watch server/src/index.ts",
    "server:prod": "tsx server/src/index.ts",
    "start": "concurrently -k -p \"[{name}]\" -n \"VITE,API\" -c \"cyan.bold,green.bold\" \"npm run dev\" \"npm run server\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@mediapipe/tasks-vision": "^0.10.14",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "^1.7.12",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "framer-motion": "^11.5.4",
    "lucide-react": "^0.441.0",
    "mongodb": "^7.7.0",
    "mqtt": "^5.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.5.2",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.11",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  }
}
